# ------------------------------------------------------------
# StarBoard production environment template
# Copy to .env.production and fill in secure values.
# ------------------------------------------------------------

# Deployment controls
DEPLOY_BRANCH=main
GIT_REMOTE=origin
APP_PORT=3000
APP_HEALTHCHECK_URL=http://127.0.0.1:3000/api/auth/me
RUN_SEED=false

# Application
APP_URL=https://starboard.example.com
AUTH_SECRET=replace-with-long-random-secret
VOICE_TOKEN_SALT=replace-with-long-random-salt
NODE_ENV=production
PORT=3000

# PostgreSQL
POSTGRES_DB=starboard
POSTGRES_USER=starboard
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgresql://starboard:replace-with-strong-db-password@db:5432/starboard?schema=public
DIRECT_URL=postgresql://starboard:replace-with-strong-db-password@db:5432/starboard?schema=public

# Optional: one-time seed account defaults
SEED_PARENT_EMAIL=parent@starboard.local
SEED_PARENT_PASSWORD=ChangeMe123!
SEED_VOICE_TOKEN=starboard-voice-dev-token

# Optional backup location (used by scripts/backup-db.sh)
BACKUP_DIR=./backups
