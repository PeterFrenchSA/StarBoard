{
  "name": "starboard",
  "version": "0.1.0",
  "private": true,
  "description": "StarBoard family rewards app",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production prisma generate && NODE_ENV=production next build --webpack",
    "start": "NODE_ENV=production next start",
    "storybook": "storybook dev --port ${STORYBOOK_PORT:-6006} --host 0.0.0.0",
    "build-storybook": "storybook build",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run prisma:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^5.10.0",
    "lucide-react": "^0.552.0",
    "next": "^16.1.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^20.4.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^10.2.17",
    "@storybook/nextjs": "^7.0.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.1.4",
    "postcss": "^8.5.6",
    "prisma": "^6.8.0",
    "storybook": "^10.2.17",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
