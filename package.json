{
  "name": "starboard",
  "version": "0.1.0",
  "private": true,
  "description": "StarBoard family rewards app",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production prisma generate && NODE_ENV=production next build --webpack",
    "start": "NODE_ENV=production next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:storybook",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run prisma:seed"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^5.10.0",
    "lucide-react": "^0.552.0",
    "next": "16.3.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^20.4.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^10.2.19",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-onboarding": "^10.2.19",
    "@storybook/addon-vitest": "^10.2.19",
    "@storybook/nextjs-vite": "^10.2.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-storybook": "^10.2.19",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "prisma": "6.19.3",
    "storybook": "^10.2.19",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
